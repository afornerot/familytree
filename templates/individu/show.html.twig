{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <script>localStorage.setItem('familytree_main_id', '{{ individu.id }}');</script>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>{{ title }}</h1>
        <div>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_individu_modifier', {id: individu.id}) }}" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Modifier
                </a>
            {% endif %}
            <a href="{{ path('app_home') }}" class="btn btn-secondary">Retour</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body text-center">
                    {% if individu.photo %}
                        <img src="{{ individu.photo }}"
                             class="rounded-circle mb-3"
                             style="width:150px; height:150px; object-fit:cover;"
                             alt="{{ individu.nomComplet }}">
                    {% else %}
                        <i class="fas fa-user-circle fa-8x text-muted mb-3"></i>
                    {% endif %}
                    <h3>{{ individu.nomComplet }}</h3>
                    <p class="text-muted">
                        {{ individu.sexe == 'M' ? 'Né' : 'Née' }}
                        {% if individu.dateNaissance %}
                            le {{ individu.dateNaissance|date('d/m/Y') }}
                        {% endif %}
                        {% if individu.lieuNaissance %}
                            à {{ individu.lieuNaissance }}
                        {% endif %}
                    </p>
                    {% if individu.isDecede %}
                        <p class="text-muted">
                            Décédé(e) le {{ individu.dateDeces|date('d/m/Y') }}
                        </p>
                    {% endif %}
                </div>
            </div>

            {% if individu.notes %}
                <div class="card mb-3">
                    <div class="card-header">Notes</div>
                    <div class="card-body">
                        <p>{{ individu.notes|nl2br }}</p>
                    </div>
                </div>
            {% endif %}

            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-folder-open"></i> Fichiers</div>
                <div class="card-body">
                    {{ render(path('bninefiles_files', {domain: 'file', id: individu.id, editable: 0, compact: 1})) }}
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-sitemap"></i> Arbre familial</div>
                <div class="card-body p-0">
                    <div id="MiniTree" class="f3"></div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-images"></i> Galerie</div>
                <div class="card-body">
                    {{ render(path('bninefiles_files_gallery', {domain: 'gallery', id: individu.id, editable: 0, compact: 1})) }}
                </div>
            </div>


        </div>
    </div>
{% endblock %}

{% block localscript %}
    <script>
    (function() {
        const personId = '{{ individu.id }}';
        const chartUrl = '{{ path("app_individu_family_data", {id: individu.id}) }}';

        async function loadMiniTree() {
            const data = await (await fetch(chartUrl + '?t=' + Date.now())).json();
            if (!data.length) return;

            const container = document.getElementById('MiniTree');
            container.innerHTML = '';

            const chart = f3.createChart('#MiniTree', data);

            chart.setCardHtml()
                .setCardDisplay([
                    function(d) { return (d.data['last name'] || '').toUpperCase(); },
                    function(d) { return (d.data['first name'] || '').split(' ')[0] || ''; },
                    function(d) {
                        var b = d.data['birthday'] || '';
                        var de = d.data['death'] || '';
                        var by = b.split('/').pop() || '';
                        var dy = de.split('/').pop() || '';
                        return by || dy ? by + (by && dy ? ' - ' : '') + dy : '';
                    }
                ]);

            chart.setCardXSpacing(250);
            chart.setCardYSpacing(120);
            chart.setAncestryDepth(3);
            chart.setProgenyDepth(3);
            chart.setSingleParentEmptyCard(false);

            chart.updateMainId(personId);
            chart.updateTree({ initial: true });

            var showUrl = '{{ path("app_individu_show", {id: "__ID__"}) }}';

            document.getElementById('MiniTree').addEventListener('click', function(e) {
                var el = e.target;
                while (el && el.id !== 'MiniTree') {
                    var d = el.__data__;
                    if (d && (d.id || (d.data && d.data.id))) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        var id = d.id || d.data.id;
                        if (id && id !== personId) {
                            window.location.href = showUrl.replace('__ID__', id);
                        }
                        return;
                    }
                    el = el.parentElement || el.parentNode;
                }
            }, true);
        }

        document.addEventListener('DOMContentLoaded', loadMiniTree);
    })();
    </script>
{% endblock %}
