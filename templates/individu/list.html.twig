{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <h1>{{title}}</h1>
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_admin_individu_ajouter') }}" class="btn btn-success mb-3">
            <i class="fas fa-plus"></i> Ajouter un individu
        </a>
    {% endif %}

    <div class="dataTable_wrapper">
        <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%">
            <thead>
            <tr style="font-size:0.8em">
                <th width="80px" class="no-sort">Action</th>
                <th width="50px" class="no-sort">Photo</th>
                <th>Nom</th>
                <th>Prénom(s)</th>
                <th>Sexe</th>
                <th>Né(e) le</th>
                <th>Mort le</th>
                <th>Père</th>
                <th>Mère</th>
                <th>Conjoint(s)</th>
                <th>Notes</th>
            </tr>
            </thead>
            <tbody>
                {% for individu in individus %}
                    <tr>
                        <td>
                            <a href="{{ path('app_individu_show', {id: individu.id}) }}" title="Voir">
                                <i class="fas fa-eye fa-lg"></i>
                            </a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_admin_individu_modifier', {id: individu.id}) }}" class="ms-1" title="Modifier">
                                    <i class="fas fa-edit fa-lg"></i>
                                </a>
                            {% endif %}
                        </td>
                        <td>
                            {% if individu.photo %}
                                <img class="avatar" src="{{ individu.photo }}">
                            {% else %}
                                <i class="fas fa-user-circle fa-2x text-muted"></i>
                            {% endif %}
                        </td>
                        <td>{{ individu.nomNaissance }}</td>
                        <td>
                            {{ individu.prenom1 }}
                            {% if individu.prenom2 %} {{ individu.prenom2 }}{% endif %}
                            {% if individu.prenom3 %} {{ individu.prenom3 }}{% endif %}
                        </td>
                        <td>{{ individu.sexe == 'M' ? 'H' : 'F' }}</td>
                        <td>{{ individu.dateNaissance ? individu.dateNaissance|date('d/m/Y') : '' }}</td>
                        <td>{{ individu.dateDeces ? individu.dateDeces|date('d/m/Y') : '' }}</td>
                        <td style="font-size:0.8em">
                            {% if individu.pere %}
                                <a href="{{ path('app_individu_show', {id: individu.pere.id}) }}">{{ individu.pere.nomNaissance }} {{ individu.pere.prenom1 }}</a>
                            {% endif %}
                        </td>
                        <td style="font-size:0.8em">
                            {% if individu.mere %}
                                <a href="{{ path('app_individu_show', {id: individu.mere.id}) }}">{{ individu.mere.nomNaissance }} {{ individu.mere.prenom1 }}</a>
                            {% endif %}
                        </td>
                        <td style="font-size:0.8em">
                            {% set mariages = individu.tousLesMariages %}
                            {% for mariage in mariages %}
                                {% set conjoint = mariage.individu1.id == individu.id ? mariage.individu2 : mariage.individu1 %}
                                <a href="{{ path('app_individu_show', {id: conjoint.id}) }}">
                                    {{ conjoint.nomNaissance }} {{ conjoint.prenom1 }}
                                </a><br>
                            {% endfor %}
                        </td>
                        <td style="font-size:0.8em">{{ individu.notes }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block localscript %}
    <script>
        $(document).ready(function() {
            $('#dataTables').DataTable({
                columnDefs: [ { "targets": "no-sort", "orderable": false } ],
                responsive: true,
                iDisplayLength: 100,
                order: [[ 1, "asc" ]]
            });
        });
    </script>
{% endblock %}
